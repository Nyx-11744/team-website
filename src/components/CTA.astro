---
import site from '../config/site';
import { url } from '../lib/url';
---

<section class="cta">
  <div class="wrap cta__inner">
    <div>
      <span class="eyebrow">Get involved</span>
      <h2>Help launch a rookie team.</h2>
      <p class="lede">
        NYX is <strong>{site.teamName} {site.teamNumber}</strong>, a {site.rookieYear} rookie team out of
        {site.location}. Sponsors, mentors, and community partners make the first season possible.
      </p>
    </div>
    <div class="cta__actions">
      <a class="btn btn--primary" href={url('/sponsors#become-a-sponsor')}>Sponsor NYX</a>
      <a class="btn btn--ghost" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(60% 120% at 15% 0%, rgba(139, 92, 246, 0.14), transparent 65%),
      var(--bg-raised);
    padding-block: clamp(3rem, 7vw, 4.5rem);
  }
  .cta__inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .cta__actions { display: flex; flex-direction: column; gap: 0.75rem; }

  @media (max-width: 800px) {
    .cta__inner { grid-template-columns: 1fr; }
  }
</style>

<style is:global>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.8rem 1.4rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    text-align: center;
    border: 1px solid transparent;
    transition: filter 140ms ease, border-color 140ms ease, background 140ms ease;
  }
  .btn--primary {
    background: linear-gradient(135deg, var(--accent-bright), var(--accent));
    color: #0b0813;
  }
  .btn--primary:hover { color: #0b0813; filter: brightness(1.1); }
  .btn--ghost {
    border-color: var(--line-strong);
    color: var(--text);
    background: rgba(255, 255, 255, 0.03);
  }
  .btn--ghost:hover { border-color: var(--accent-line); color: var(--accent-soft); }
</style>
