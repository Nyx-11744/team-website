---
/**
 * Styled stand-in for a photo that hasn't been shot yet.
 * Drop the real file into /public and pass `src` to replace it — the aspect
 * ratio and framing stay identical, so nothing else needs to change.
 */
interface Props {
  src?: string | null;
  alt?: string;
  label?: string;
  ratio?: string;
  class?: string;
}
const { src = null, alt = '', label = 'Photo coming soon', ratio = '16 / 9', class: cls = '' } = Astro.props;
---

{src ? (
  <img class:list={['ph-img', cls]} src={src} alt={alt} style={`aspect-ratio:${ratio}`} loading="lazy" />
) : (
  <div class:list={['ph-box', cls]} style={`aspect-ratio:${ratio}`} role="img" aria-label={label}>
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
      <rect x="3" y="4" width="18" height="16" rx="2" />
      <circle cx="8.5" cy="9.5" r="1.6" />
      <path d="M21 16l-5.5-5.5L6 20" />
    </svg>
    <span>{label}</span>
  </div>
)}

<style>
  .ph-img {
    width: 100%;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }
  .ph-box {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border-radius: var(--radius);
    border: 1px dashed var(--line-strong);
    background:
      linear-gradient(135deg, rgba(139, 92, 246, 0.07), transparent 60%),
      var(--bg-card);
    color: var(--text-faint);
    font-size: 0.8rem;
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
    text-align: center;
    padding: 1rem;
  }
</style>
