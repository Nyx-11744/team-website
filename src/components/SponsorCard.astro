---
import { url } from '../lib/url';

interface Props {
  name: string;
  logo?: string | null;
  href?: string | null;
  blurb?: string | null;
  size?: 'lg' | 'md' | 'sm';
}
const { name, logo = null, href = null, blurb = null, size = 'md' } = Astro.props;
const Tag = href ? 'a' : 'div';
const attrs = href ? { href, target: '_blank', rel: 'noopener noreferrer' } : {};
---

<Tag class:list={['spn', `spn--${size}`]} {...attrs}>
  <div class="spn__logo">
    {logo ? (
      <img src={url(`/sponsors/${logo}`)} alt={`${name} logo`} loading="lazy" />
    ) : (
      <span class="spn__wordmark">{name}</span>
    )}
  </div>
  <div class="spn__meta">
    <strong>{name}</strong>
    {blurb && <p class="ph">{blurb}</p>}
  </div>
</Tag>

<style>
  .spn {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-card);
    color: var(--text);
    transition: border-color 160ms ease, background 160ms ease;
  }
  .spn:hover { border-color: var(--accent-line); background: var(--bg-card-hover); }

  .spn__logo {
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px dashed var(--line-strong);
    padding: 1rem;
  }
  .spn--lg .spn__logo { min-height: 150px; }
  .spn--md .spn__logo { min-height: 118px; }
  .spn--sm .spn__logo { min-height: 92px; }

  .spn__logo img { max-height: 84px; width: auto; object-fit: contain; }

  .spn__wordmark {
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    font-size: 1.15rem;
    text-align: center;
  }
  .spn--lg .spn__wordmark { font-size: 1.6rem; }

  .spn__meta strong { display: block; font-size: 1rem; }
  .spn__meta p { margin: 0.3rem 0 0; font-size: 0.85rem; }
</style>
