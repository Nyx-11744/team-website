---
import { url } from '../lib/url';

/**
 * A sponsor tile. Shows the logo when one is set in src/data/sponsors.json,
 * otherwise falls back to the sponsor's name as a wordmark.
 *
 * There is no description — the name appears on hover (and on keyboard focus).
 * On touch devices, where hovering is not possible, the name is always shown.
 */
interface Props {
  name: string;
  /** Filename inside public/sponsors/ — omit to show the name as a wordmark. */
  logo?: string | null;
  href?: string | null;
  size?: 'lg' | 'md' | 'sm';
}
const { name, logo = null, href = null, size = 'md' } = Astro.props;

const Tag = href ? 'a' : 'div';
const attrs = href ? { href, target: '_blank', rel: 'noopener noreferrer' } : {};
---

<Tag class:list={['spn', `spn--${size}`, { 'spn--named': !logo }]} {...attrs} tabindex={href ? undefined : '0'}>
  <div class="spn__logo">
    {logo ? (
      <img src={url(`/sponsors/${logo}`)} alt={name} loading="lazy" />
    ) : (
      <span class="spn__wordmark">{name}</span>
    )}
  </div>
  {logo && <span class="spn__name" aria-hidden="true">{name}</span>}
</Tag>

<style>
  .spn {
    position: relative;
    display: grid;
    place-items: center;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-card);
    color: var(--text);
    overflow: hidden;
    transition: border-color 160ms ease, background 160ms ease, transform 160ms ease;
  }
  .spn:hover,
  .spn:focus-visible {
    border-color: var(--accent-line);
    background: var(--bg-card-hover);
    transform: translateY(-2px);
  }

  /* Tile sizes — width is fixed so rows centre cleanly. */
  .spn--lg { width: clamp(200px, 26vw, 280px); min-height: 170px; }
  .spn--md { width: clamp(170px, 21vw, 230px); min-height: 140px; }
  .spn--sm { width: clamp(150px, 18vw, 200px); min-height: 120px; }

  .spn__logo { display: grid; place-items: center; width: 100%; }
  .spn__logo img {
    max-height: 92px;
    max-width: 100%;
    width: auto;
    object-fit: contain;
    transition: opacity 160ms ease, transform 160ms ease;
  }
  .spn--lg .spn__logo img { max-height: 110px; }
  .spn--sm .spn__logo img { max-height: 74px; }

  /* No logo yet: the name is the tile. */
  .spn__wordmark {
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    font-size: 1.15rem;
    text-align: center;
  }
  .spn--lg .spn__wordmark { font-size: 1.5rem; }
  .spn:hover .spn__wordmark,
  .spn:focus-visible .spn__wordmark { color: var(--text); }

  /* Name revealed on hover, over the logo. */
  .spn__name {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 0.6rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    text-align: center;
    color: var(--text);
    background: linear-gradient(to top, var(--bg-card-hover) 55%, transparent);
    opacity: 0;
    transform: translateY(0.5rem);
    transition: opacity 160ms ease, transform 160ms ease;
    pointer-events: none;
  }
  .spn:hover .spn__name,
  .spn:focus-visible .spn__name { opacity: 1; transform: translateY(0); }

  /* Dim the logo slightly so the name stays readable over it. */
  .spn:hover .spn__logo img,
  .spn:focus-visible .spn__logo img { transform: translateY(-0.35rem); }

  /* Touch devices cannot hover — show the name permanently. */
  @media (hover: none) {
    .spn__name { opacity: 1; transform: none; }
    .spn__logo img { transform: translateY(-0.35rem); }
  }
</style>
