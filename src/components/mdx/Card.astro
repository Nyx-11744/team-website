---
interface Props { title?: string }
const { title } = Astro.props;
---
<article class="mdx-card">
  {title && <h3>{title}</h3>}
  <div class="mdx-card__body"><slot /></div>
</article>

<style>
  .mdx-card {
    background: var(--bg-card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    transition: border-color 160ms ease, background 160ms ease;
  }
  .mdx-card:hover { border-color: var(--accent-line); background: var(--bg-card-hover); }
  .mdx-card h3 { font-size: 1.15rem; margin-bottom: 0.5rem; }
  .mdx-card__body :global(p) { margin: 0 0 0.75rem; font-size: 0.92rem; }
  .mdx-card__body :global(p:last-child) { margin-bottom: 0; }
</style>
