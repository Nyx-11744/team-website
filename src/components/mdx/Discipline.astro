---
/** One of the four discipline panels inside a subsystem write-up. */
interface Props { name: string }
const { name } = Astro.props;
---
<div class="disc__item">
  <h4>{name}</h4>
  <slot />
</div>

<style>
  .disc__item h4 {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-soft);
    margin-bottom: 0.5rem;
  }
  .disc__item :global(p) { margin: 0 0 0.6rem; font-size: 0.9rem; }
  .disc__item :global(p:last-child) { margin-bottom: 0; }
</style>
