---
interface Props { year: string | number; title: string }
const { year, title } = Astro.props;
---
<li class="mdx-milestone">
  <span class="mdx-milestone__year">{year}</span>
  <div>
    <h3>{title}</h3>
    <slot />
  </div>
</li>

<style>
  .mdx-milestone {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
  }
  .mdx-milestone:last-child { border-bottom: 1px solid var(--line); }
  .mdx-milestone__year {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    color: var(--accent-soft);
    padding-top: 0.35rem;
  }
  .mdx-milestone h3 { margin-bottom: 0.35rem; }
  .mdx-milestone :global(p) { margin: 0; }

  @media (max-width: 820px) {
    .mdx-milestone { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
