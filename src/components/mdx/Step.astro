---
interface Props { title: string }
const { title } = Astro.props;
---
<li class="mdx-step">
  <span class="mdx-step__num" aria-hidden="true"></span>
  <div>
    <h3>{title}</h3>
    <slot />
  </div>
</li>

<style>
  .mdx-step {
    display: flex;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-card);
    counter-increment: step;
  }
  .mdx-step__num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
    flex-shrink: 0;
  }
  .mdx-step__num::before { content: counter(step, decimal-leading-zero); }
  .mdx-step h3 { font-size: 1.05rem; margin-bottom: 0.3rem; }
  .mdx-step :global(p) { margin: 0; font-size: 0.9rem; }
</style>
