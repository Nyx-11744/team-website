---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CTA from '../components/CTA.astro';
import Placeholder from '../components/Placeholder.astro';
import site from '../data/site.json';

const timeline = [
  { year: '2025', title: 'PLACEHOLDER — Founding', body: 'PLACEHOLDER — how NYX came together and who started it.' },
  { year: '2026', title: 'PLACEHOLDER — Rookie season', body: 'PLACEHOLDER — first build season, first competition, what the team is aiming for.' },
  { year: 'Next', title: 'PLACEHOLDER — Where we are going', body: 'PLACEHOLDER — goals for the seasons ahead.' },
];

const values = [
  { title: 'PLACEHOLDER — Value One', body: 'PLACEHOLDER — what this value means in practice for NYX.' },
  { title: 'PLACEHOLDER — Value Two', body: 'PLACEHOLDER — what this value means in practice for NYX.' },
  { title: 'PLACEHOLDER — Value Three', body: 'PLACEHOLDER — what this value means in practice for NYX.' },
  { title: 'PLACEHOLDER — Value Four', body: 'PLACEHOLDER — what this value means in practice for NYX.' },
];
---

<Base title="About" description="About FRC Team 11744 NYX, a rookie team from San Diego, California.">
  <PageHeader
    eyebrow="About"
    title="A rookie team out of San Diego."
    lede="NYX is FRC Team 11744, competing for the first time in the 2026 season."
  />

  <section class="section">
    <div class="wrap split">
      <div>
        <h2>Our mission</h2>
        <p class="ph">
          PLACEHOLDER — the mission statement. Two to four sentences on what NYX exists to do,
          for its students and for the community around it.
        </p>
        <p class="ph">
          PLACEHOLDER — a second paragraph with more detail: how the team operates, what makes
          it different, and what students take away from a season.
        </p>
      </div>
      <Placeholder label="Team photo coming soon" ratio="4 / 3" />
    </div>
  </section>

  <section class="section section--tight alt">
    <div class="wrap">
      <span class="eyebrow">What we stand for</span>
      <h2>Values</h2>
      <div class="grid grid-2 vgrid">
        {values.map((v) => (
          <article class="card">
            <h3>{v.title}</h3>
            <p class="ph">{v.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">History</span>
      <h2>How we got here</h2>
      <ol class="timeline">
        {timeline.map((t) => (
          <li>
            <span class="timeline__year">{t.year}</span>
            <div>
              <h3>{t.title}</h3>
              <p class="ph">{t.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--tight alt">
    <div class="wrap">
      <span class="eyebrow">Recognition</span>
      <h2>Awards</h2>
      <p class="lede ph">
        PLACEHOLDER — awards and honors will be listed here as {site.teamName} earns them.
      </p>
    </div>
  </section>

  <CTA />
</Base>

<style>
  .split {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }
  .alt { background: var(--bg-raised); border-block: 1px solid var(--line); }
  .vgrid { margin-top: 1.75rem; }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    gap: 0;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
  }
  .timeline li:last-child { border-bottom: 1px solid var(--line); }
  .timeline__year {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    color: var(--accent-soft);
    padding-top: 0.35rem;
  }
  .timeline h3 { margin-bottom: 0.35rem; }
  .timeline p { margin: 0; }

  @media (max-width: 820px) {
    .split { grid-template-columns: 1fr; }
    .timeline li { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
