---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CTA from '../components/CTA.astro';
import Placeholder from '../components/Placeholder.astro';
import Prose from '../components/Prose.astro';
import { loadPage } from '../lib/content';
import { url } from '../lib/url';

const { title, eyebrow, lede, description, Content, components } = await loadPage('about');

// Filenames inside public/team/. Add or remove as photos come in.
const teamPhotos = ['assembly-ftm.jpg', 'assembly2-ftm.jpg', 'sw-elec-ftm.jpg'];
---

<Base title="About" description={description}>
  <PageHeader eyebrow={eyebrow} title={title} lede={lede} />

  <section class="section">
    <div class="wrap split">
      <Prose><Content components={components} /></Prose>
      <div class="aside">
        {teamPhotos.length > 0 ? (
          teamPhotos.map((photo) => (
            <Placeholder src={url(`/team/${photo}`)} alt="Nyx students at work" ratio="4 / 3" class="aside__photo" />
          ))
        ) : (
          <Placeholder label="Team photo coming soon" ratio="4 / 3" />
        )}
      </div>
    </div>
  </section>

  <CTA />
</Base>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }
  .aside {
    position: sticky;
    top: 6rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  @media (max-width: 900px) {
    .split { grid-template-columns: 1fr; }
    .aside { position: static; order: -1; }
  }
</style>
