---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CTA from '../components/CTA.astro';
import Placeholder from '../components/Placeholder.astro';
import Prose from '../components/Prose.astro';
import subteamData from '../data/subteams.json';
import { loadPage, isPlaceholder } from '../lib/content';
import { url } from '../lib/url';

const { title, eyebrow, lede, description, Content, components } = await loadPage('about');

// Filenames inside public/team/. Add or remove as photos come in.
const teamPhotos = ['assembly-ftm.jpg', 'assembly2-ftm.jpg', 'sw-elec-ftm.jpg'];

const subteams = [...subteamData.subteams].sort((a, b) => a.order - b.order);
---

<Base title="About" description={description}>
  <PageHeader eyebrow={eyebrow} title={title} lede={lede} />

  <section class="section">
    <div class="wrap split">
      <Prose><Content components={components} /></Prose>
      <div class="aside">
        {teamPhotos.length > 0 ? (
          teamPhotos.map((photo) => (
            <Placeholder src={url(`/team/${photo}`)} alt="Nyx students at work" ratio="4 / 3" class="aside__photo" />
          ))
        ) : (
          <Placeholder label="Team photo coming soon" ratio="4 / 3" />
        )}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <span class="eyebrow">Structure</span>
      <h2>Subteams</h2>
      <div class="grid grid-3 sub">
        {subteams.map((s) => (
          <article class="card">
            <h3>{s.name}</h3>
            <p class:list={['sub__body', { ph: isPlaceholder(s.description) }]}>{s.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</Base>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }
  .aside {
    position: sticky;
    top: 6rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  @media (max-width: 900px) {
    .split { grid-template-columns: 1fr; }
    .aside { position: static; order: -1; }
  }

  .sub { margin-top: 1.75rem; }
  .sub__body { margin: 0; font-size: 0.92rem; }

  .alt { background: var(--bg-raised); border-block: 1px solid var(--line); }
</style>
