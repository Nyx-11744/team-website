---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import Placeholder from '../components/Placeholder.astro';
import Prose from '../components/Prose.astro';
import SponsorCard from '../components/SponsorCard.astro';
import site from '../config/site';
import sponsorData from '../data/sponsors.json';
import sponsorshipData from '../data/sponsorship.json';
import { loadPage, byOrder, isPlaceholder } from '../lib/content';
import { url } from '../lib/url';

const { lede, description, eyebrow, Content, components } = await loadPage('home');

const robots = (await getCollection('robots')).sort(byOrder);
const featured = robots[0];
const subsystems = featured
  ? [...featured.data.subsystems].sort((a, b) => a.order - b.order)
  : [];

const tierRank = new Map(sponsorshipData.tiers.map((t) => [t.id, t.order]));

/** Highest tier first on the home strip. */
const strip = [...sponsorData.sponsors].sort(
  (a, b) => (tierRank.get(b.tier) ?? 0) - (tierRank.get(a.tier) ?? 0) || a.order - b.order,
);

/**
 * The marquee scrolls by translating one "set" width at a time. With only a
 * handful of sponsors, one or two sets may not be wide enough to fill (let
 * alone overflow) a wide screen, which breaks the illusion of an infinite
 * loop — you'd see blank space before it jumps back. Repeating enough sets
 * up front keeps the track comfortably wider than any viewport regardless of
 * how many sponsors there are.
 */
const MARQUEE_SETS = 6;
const marqueeRepeats = Array.from({ length: MARQUEE_SETS - 1 }, () => strip).flat();
---

<Base description={description}>
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__copy">
        <span class="eyebrow">FRC Team {site.teamNumber} · {site.location}</span>
        <h1 class="hero__title">
          <span class="hero__name">Nyx</span>
          <span class="hero__sub ph">{lede}</span>
        </h1>
        <p class="lede ph">{description}</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={url('/sponsors#become-a-sponsor')}>Sponsor Us</a>
          <a class="btn btn--ghost" href={url('/robots')}>See the robot</a>
        </div>

        <dl class="hero__stats">
          <div><dt>Team</dt><dd>{site.teamNumber}</dd></div>
          <div><dt>Rookie Year</dt><dd>2026</dd></div>
          <div><dt>Based In</dt><dd>San Diego</dd></div>
        </dl>
      </div>

      <div class="hero__mark">
        <img src={url('/logo.png')} alt="Logo" width="420" height="420" />
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">{eyebrow}</span>
      <Prose><Content components={components} /></Prose>
      <a class="arrow-link" href={url('/about')}>More about Nyx →</a>
    </div>
  </section>

  {featured && (
    <section class="section section--tight robot-feature">
      <div class="wrap robot-feature__inner">
        <div>
          <span class="eyebrow">{featured.data.season}</span>
          <h2 class="ph">{featured.data.name}</h2>
          <p class="ph">{featured.data.summary}</p>
          <ul class="chiplist">
            {subsystems.map((s) => (
              <li class:list={['chip', { ph: isPlaceholder(s.name) }]}>{s.name}</li>
            ))}
          </ul>
          <a class="btn btn--ghost" href={url(`/robots/${featured.id}`)}>Robot breakdown</a>
        </div>
        <Placeholder
          src={featured.data.hero ? url(`/robots/${featured.id}/${featured.data.hero}`) : null}
          alt={featured.data.name}
          label="Robot photo coming soon"
          ratio="4 / 3"
        />
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Our sponsors</span>
      <h2>Built with the support of</h2>
      <p class="lede">
        Grace Academy serves as our fiscal sponsor. These partners
        fund the parts, tools, and registration that put our team on the field.
      </p>
    </div>

    <div class="marquee">
      <div class="marquee__track">
        {strip.map((s) => (
          <SponsorCard name={s.name} logo={s.logo} href={s.url} size="sm" />
        ))}
        <div class="marquee__dupe" aria-hidden="true">
          {marqueeRepeats.map((s) => (
            <SponsorCard name={s.name} logo={s.logo} href={s.url} size="sm" />
          ))}
        </div>
      </div>
    </div>

    <div class="wrap">
      <a class="arrow-link" href={url('/sponsors')}>All sponsors & sponsorship tiers →</a>
    </div>
  </section>

  <CTA />
</Base>

<style>
  .hero { padding-block: clamp(3rem, 9vw, 6.5rem); }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__title { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1rem; }
  .hero__name {
    font-size: clamp(4rem, 13vw, 8.5rem);
    line-height: 0.9;
    letter-spacing: 0.02em;
    background: linear-gradient(150deg, #ffffff 20%, var(--accent-soft) 65%, var(--accent) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__sub {
    font-size: clamp(1rem, 2vw, 1.35rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.4;
    max-width: 30ch;
  }

  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.75rem 0 2.5rem; }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin: 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .hero__stats dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .hero__stats dd {
    margin: 0.25rem 0 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent-soft);
  }

  .hero__mark img {
    width: 100%;
    height: auto;
    border-radius: 26px;
    border: 1px solid var(--line);
    box-shadow: 0 30px 80px -30px rgba(139, 92, 246, 0.55);
  }

  .robot-feature { background: var(--bg-raised); border-block: 1px solid var(--line); }
  .robot-feature__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .chiplist {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 1.25rem 0 1.75rem;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgba(255, 255, 255, 0.03);
  }

  .marquee {
    margin-top: 2rem;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 8%,
      #000 92%,
      transparent
    );
  }
  .marquee__track {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: max-content;
    animation: marquee 32s linear infinite;
  }
  .marquee:hover .marquee__track { animation-play-state: paused; }
  .marquee__dupe { display: contents; }

  /* Translates by exactly one repeated set (1 of 6), so the loop point is invisible. */
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-100% / 6)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track { animation: none; }
    .marquee { overflow-x: auto; }
  }

  @media (max-width: 880px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__mark { max-width: 300px; }
    .robot-feature__inner { grid-template-columns: 1fr; }
  }
</style>

<style is:global>
  .arrow-link { display: inline-block; margin-top: 2rem; font-weight: 600; font-size: 0.95rem; }
</style>
