---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import Placeholder from '../components/Placeholder.astro';
import SponsorCard from '../components/SponsorCard.astro';
import site from '../data/site.json';
import sponsorData from '../data/sponsors.json';
import robotData from '../data/robots.json';
import { url } from '../lib/url';

const featured = robotData.robots[0];
const allSponsors = sponsorData.tiers.flatMap((t) => t.sponsors);

const pillars = [
  {
    title: 'PLACEHOLDER — Build',
    body: 'PLACEHOLDER — a sentence on design, fabrication, and the engineering process at NYX.',
  },
  {
    title: 'PLACEHOLDER — Learn',
    body: 'PLACEHOLDER — a sentence on how students are trained and how skills carry beyond the season.',
  },
  {
    title: 'PLACEHOLDER — Serve',
    body: 'PLACEHOLDER — a sentence on outreach and NYX\u2019s role in the San Diego community.',
  },
];
---

<Base>
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__copy">
        <span class="eyebrow">FRC Team {site.teamNumber} · {site.location}</span>
        <h1 class="hero__title">
          <span class="hero__name">NYX</span>
          <span class="hero__sub ph">{site.tagline}</span>
        </h1>
        <p class="lede ph">{site.shortDescription}</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={url('/sponsors#become-a-sponsor')}>Sponsor Us</a>
          <a class="btn btn--ghost" href={url('/robots')}>See the robot</a>
        </div>

        <dl class="hero__stats">
          <div><dt>Team</dt><dd>{site.teamNumber}</dd></div>
          <div><dt>Rookie Year</dt><dd>{site.rookieYear}</dd></div>
          <div><dt>Based In</dt><dd>San Diego</dd></div>
        </dl>
      </div>

      <div class="hero__mark">
        <img src={url('/logo.png')} alt="NYX team logo — an owl perched on a crescent moon" width="420" height="420" />
      </div>
    </div>
  </section>

  <hr class="divider" />

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Who we are</span>
      <h2>PLACEHOLDER — a short headline about NYX.</h2>
      <p class="lede ph">
        PLACEHOLDER — two or three sentences introducing the team: who the students are,
        what drew them together, and what the first season is for.
      </p>

      <div class="grid grid-3 pillars">
        {pillars.map((p) => (
          <article class="card">
            <h3>{p.title}</h3>
            <p class="ph">{p.body}</p>
          </article>
        ))}
      </div>

      <a class="arrow-link" href={url('/about')}>More about NYX →</a>
    </div>
  </section>

  <section class="section section--tight robot-feature">
    <div class="wrap robot-feature__inner">
      <div>
        <span class="eyebrow">{featured.season}</span>
        <h2 class="ph">{featured.name}</h2>
        <p class="ph">{featured.summary}</p>
        <ul class="chiplist">
          {featured.subsystems.map((s) => <li class="chip ph">{s.name}</li>)}
        </ul>
        <a class="btn btn--ghost" href={url(`/robots/${featured.slug}`)}>Robot breakdown</a>
      </div>
      <Placeholder label="Robot photo coming soon" ratio="4 / 3" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Our sponsors</span>
      <h2>Built with the support of</h2>
      <p class="lede">
        {sponsorData.fiscalSponsor.name} serves as our fiscal sponsor. These partners fund the
        parts, tools, and registration that put a rookie team on the field.
      </p>
      <div class="grid grid-3 sponsor-strip">
        {allSponsors.map((s) => (
          <SponsorCard name={s.name} logo={s.logo} href={s.url} size="sm" />
        ))}
      </div>
      <a class="arrow-link" href={url('/sponsors')}>All sponsors & sponsorship tiers →</a>
    </div>
  </section>

  <CTA />
</Base>

<style>
  .hero {
    padding-block: clamp(3rem, 9vw, 6.5rem);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__title { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1rem; }
  .hero__name {
    font-size: clamp(4rem, 13vw, 8.5rem);
    line-height: 0.9;
    letter-spacing: 0.02em;
    background: linear-gradient(150deg, #ffffff 20%, var(--accent-soft) 65%, var(--accent) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__sub {
    font-size: clamp(1rem, 2vw, 1.35rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.4;
    max-width: 30ch;
  }

  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.75rem 0 2.5rem; }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin: 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .hero__stats dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .hero__stats dd {
    margin: 0.25rem 0 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent-soft);
  }

  .hero__mark img {
    width: 100%;
    height: auto;
    border-radius: 26px;
    border: 1px solid var(--line);
    box-shadow: 0 30px 80px -30px rgba(139, 92, 246, 0.55);
  }

  .pillars { margin-top: 2.5rem; }

  .robot-feature {
    background: var(--bg-raised);
    border-block: 1px solid var(--line);
  }
  .robot-feature__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .chiplist {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 1.25rem 0 1.75rem;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgba(255, 255, 255, 0.03);
  }

  .sponsor-strip { margin-top: 2rem; }

  @media (max-width: 880px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__mark { max-width: 300px; }
    .robot-feature__inner { grid-template-columns: 1fr; }
  }
</style>

<style is:global>
  .arrow-link {
    display: inline-block;
    margin-top: 2rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
</style>
