---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CTA from '../components/CTA.astro';
import Placeholder from '../components/Placeholder.astro';
import Prose from '../components/Prose.astro';
import site from '../config/site';
import { loadPage, byOrder } from '../lib/content';
import { url } from '../lib/url';

const { title, eyebrow, lede, description, Content, components } = await loadPage('outreach');

const programs = await Promise.all(
  (await getCollection('programs')).sort(byOrder).map(async (entry) => ({
    ...entry.data,
    Body: (await render(entry)).Content,
  })),
);
---

<Base title="Outreach" description={description}>
  <PageHeader eyebrow={eyebrow} title={title} lede={lede} />

  <section class="section section--tight">
    <div class="wrap">
      <Prose><Content components={components} /></Prose>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Programs</span>
      <h2>What we run</h2>
      <div class="pgrid">
        {programs.map((p) => (
          <article class="pcard">
            <Placeholder
              src={p.image ? url(`/outreach/${p.image}`) : null}
              alt={p.name}
              label="Event photo coming soon"
              ratio="16 / 10"
            />
            <div class="pcard__body">
              {p.when && <span class="pcard__when">{p.when}</span>}
              <h3>{p.name}</h3>
              <div class="pcard__prose"><p.Body /></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight alt">
    <div class="wrap">
      <span class="eyebrow">Partner with us</span>
      <h2>Bring NYX to your event</h2>
      <p class="lede">
        Schools, libraries, and community groups in San Diego can request a robot demo or a
        hands-on STEM session. Email <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.
      </p>
    </div>
  </section>

  <CTA />
</Base>

<style>
  .pgrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-top: 1.75rem;
  }
  .pcard {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
  }
  .pcard__when {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-soft);
  }
  .pcard h3 { margin: 0.4rem 0 0.5rem; font-size: 1.25rem; }
  .pcard__prose :global(p) { margin: 0 0 0.6rem; font-size: 0.92rem; }
  .pcard__prose :global(p:last-child) { margin-bottom: 0; }

  .alt { background: var(--bg-raised); border-block: 1px solid var(--line); }
</style>
