---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import Placeholder from '../../components/Placeholder.astro';
import Prose from '../../components/Prose.astro';
import { mdxComponents } from '../../components/mdx';
import { byOrder } from '../../lib/content';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const robots = await getCollection('robots');
  return robots.map((robot) => ({ params: { slug: robot.id }, props: { robot } }));
}

const { robot } = Astro.props;
const { Content } = await render(robot);

const subsystems = await Promise.all(
  (await getCollection('subsystems', (s) => s.data.robot.id === robot.id))
    .sort(byOrder)
    .map(async (entry) => ({ ...entry.data, Body: (await render(entry)).Content })),
);
---

<Base title={`${robot.data.season} Robot`} description={robot.data.summary}>
  <section class="rhead">
    <div class="wrap">
      <a class="back" href={url('/robots')}>← All robots</a>
      <div class="rhead__grid">
        <div>
          <span class="eyebrow">{robot.data.season} · {robot.data.game}</span>
          <h1 class="ph">{robot.data.name}</h1>
          <p class="lede ph">{robot.data.summary}</p>

          {robot.data.specs.length > 0 && (
            <dl class="specs">
              {robot.data.specs.map((s) => (
                <div>
                  <dt>{s.label}</dt>
                  <dd class="ph">{s.value}</dd>
                </div>
              ))}
            </dl>
          )}

          {robot.data.links.length > 0 && (
            <div class="rlinks">
              {robot.data.links.map((l) => (
                <a
                  class:list={['btn', 'btn--ghost', { 'is-ph': l.placeholder }]}
                  href={l.internal ? url(l.url) : l.url}
                  target={l.url.startsWith('http') ? '_blank' : undefined}
                  rel={l.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                >{l.label}</a>
              ))}
            </div>
          )}
        </div>

        <Placeholder
          src={robot.data.hero ? url(`/robots/${robot.id}/${robot.data.hero}`) : null}
          alt={robot.data.name}
          label="Hero robot photo coming soon"
          ratio="4 / 3"
        />
      </div>
    </div>
  </section>

  {subsystems.length > 0 && (
    <section class="section">
      <div class="wrap">
        <span class="eyebrow">Breakdown</span>
        <h2>Subsystems</h2>
        <p class="lede">
          Each subsystem is documented across four disciplines so other teams — and future
          NYX students — can follow the reasoning, not just the result.
        </p>

        <div class="subs">
          {subsystems.map((sub, i) => (
            <article class="sub" id={`subsystem-${i + 1}`}>
              <div class="sub__top">
                <Placeholder
                  src={sub.image ? url(`/robots/${robot.id}/${sub.image}`) : null}
                  alt={sub.name}
                  label="Subsystem photo coming soon"
                  ratio="4 / 3"
                />
                <div>
                  <span class="sub__idx">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="ph">{sub.name}</h3>
                  <div class="sub__overview"><sub.Body components={mdxComponents} /></div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--tight alt">
    <div class="wrap">
      <Prose><Content components={mdxComponents} /></Prose>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Gallery</span>
      <h2>Build photos</h2>
      <div class="gal">
        {robot.data.gallery.length > 0
          ? robot.data.gallery.map((g) => (
              <Placeholder src={url(`/robots/${robot.id}/${g}`)} alt={robot.data.name} ratio="4 / 3" />
            ))
          : [1, 2, 3, 4].map(() => <Placeholder ratio="4 / 3" label="Build photo" />)}
      </div>
      <p class="galnote">
        Drop photos into <code>public/robots/{robot.id}/</code> and list the filenames under
        <code>gallery:</code> in <code>src/content/robots/{robot.id}.mdx</code>.
      </p>
    </div>
  </section>

  <CTA />
</Base>

<style>
  .rhead {
    padding-block: clamp(2rem, 6vw, 3.5rem) clamp(2.5rem, 6vw, 4rem);
    border-bottom: 1px solid var(--line);
  }
  .back { font-size: 0.85rem; font-family: var(--font-mono); }
  .rhead__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    margin-top: 1.5rem;
  }
  .rhead h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); }

  .specs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem 1.5rem;
    margin: 1.75rem 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .specs dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .specs dd { margin: 0.25rem 0 0; font-size: 0.95rem; font-weight: 600; }

  .rlinks { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .rlinks .is-ph { opacity: 0.62; }

  .subs { display: grid; gap: 1.5rem; margin-top: 2rem; }

  .sub {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .sub__top {
    display: grid;
    grid-template-columns: minmax(0, 300px) 1fr;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    align-items: start;
  }
  .sub__idx {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    color: var(--accent);
  }
  .sub h3 { margin: 0.35rem 0 0.5rem; font-size: 1.45rem; }
  .sub__overview :global(p) { color: var(--text-muted); }

  .alt { background: var(--bg-raised); border-block: 1px solid var(--line); }
  .gal {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .galnote { margin-top: 1.25rem; font-size: 0.82rem; color: var(--text-faint); }
  .galnote code {
    font-family: var(--font-mono);
    font-size: 0.8em;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }

  @media (max-width: 860px) {
    .rhead__grid { grid-template-columns: 1fr; }
    .sub__top { grid-template-columns: 1fr; }
  }
</style>
