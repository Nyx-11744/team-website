---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import CTA from '../../components/CTA.astro';
import Placeholder from '../../components/Placeholder.astro';
import robotData from '../../data/robots.json';
import { url } from '../../lib/url';

const robots = robotData.robots;
---

<Base title="Robots" description="Robots built by FRC Team 11744 NYX, season by season.">
  <PageHeader
    eyebrow="Robots"
    title="Every machine we have built."
    lede="Each robot gets a full breakdown: subsystem by subsystem, across design, fabrication, electrical, and code."
  />

  <section class="section">
    <div class="wrap">
      <div class="rgrid">
        {robots.map((r) => (
          <a class="rcard" href={url(`/robots/${r.slug}`)}>
            <Placeholder
              src={r.hero ? url(`/robots/${r.slug}/${r.hero}`) : null}
              alt={r.name}
              label="Robot photo coming soon"
              ratio="16 / 10"
            />
            <div class="rcard__body">
              <div class="rcard__meta">
                <span class="rcard__season">{r.season}</span>
                <span class="rcard__status">{r.status}</span>
              </div>
              <h2 class="ph">{r.name}</h2>
              <p class="ph">{r.summary}</p>
              <span class="rcard__link">View breakdown →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</Base>

<style>
  .rgrid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }

  .rcard {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    color: var(--text);
    transition: border-color 160ms ease, background 160ms ease, transform 160ms ease;
  }
  .rcard:hover {
    border-color: var(--accent-line);
    background: var(--bg-card-hover);
    transform: translateY(-2px);
  }

  .rcard__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }
  .rcard__season {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-soft);
  }
  .rcard__status {
    font-size: 0.7rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--text-faint);
  }
  .rcard h2 { font-size: 1.5rem; margin-bottom: 0.4rem; }
  .rcard p { font-size: 0.92rem; }
  .rcard__link { font-size: 0.88rem; font-weight: 600; color: var(--accent-soft); }
</style>
