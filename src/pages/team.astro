---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CTA from '../components/CTA.astro';
import Prose from '../components/Prose.astro';
import subteamData from '../data/subteams.json';
import { loadPage, isPlaceholder } from '../lib/content';

const { title, eyebrow, lede, description, Content, components } = await loadPage('team');

const subteams = [...subteamData.subteams].sort((a, b) => a.order - b.order);
---

<Base title="The Team" description={description}>
  <PageHeader eyebrow={eyebrow} title={title} lede={lede} />

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Structure</span>
      <h2>Subteams</h2>
      <div class="grid grid-3 sub">
        {subteams.map((s) => (
          <article class="card">
            <h3>{s.name}</h3>
            <p class:list={['sub__body', { ph: isPlaceholder(s.description) }]}>{s.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <Prose><Content components={components} /></Prose>
    </div>
  </section>

  <CTA />
</Base>

<style>
  .sub { margin-top: 1.75rem; }
  .sub__body { margin: 0; font-size: 0.92rem; }

  .alt { background: var(--bg-raised); border-block: 1px solid var(--line); }
</style>
