---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CTA from '../components/CTA.astro';
import Prose from '../components/Prose.astro';
import { loadPage, byOrder } from '../lib/content';

const { title, eyebrow, lede, description, Content, components } = await loadPage('team');

const subteams = await Promise.all(
  (await getCollection('subteams')).sort(byOrder).map(async (entry) => ({
    ...entry.data,
    Body: (await render(entry)).Content,
  })),
);
---

<Base title="The Team" description={description}>
  <PageHeader eyebrow={eyebrow} title={title} lede={lede} />

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Structure</span>
      <h2>Subteams</h2>
      <div class="grid grid-3 sub">
        {subteams.map((s) => (
          <article class="card">
            <h3>{s.name}</h3>
            <div class="sub__body"><s.Body /></div>
            <ul class="skills">
              {s.skills.map((k) => <li>{k}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <Prose><Content components={components} /></Prose>
    </div>
  </section>

  <CTA />
</Base>

<style>
  .sub { margin-top: 1.75rem; }
  .sub__body :global(p) { margin: 0 0 0.5rem; font-size: 0.92rem; color: var(--text-faint); font-style: italic; }

  .skills {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .skills li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--text-faint);
  }

  .alt { background: var(--bg-raised); border-block: 1px solid var(--line); }
</style>
